# =============================================================================
# .env.example — Environment variables template for OCPP Sentinel
# =============================================================================
# Copy this file to .env and set your API keys if available.
# If no key is set, OCPP Sentinel automatically uses grounded local RAG reasoning!

# OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
